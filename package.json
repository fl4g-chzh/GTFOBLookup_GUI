{
  "name": "gtfoblookup-gui",
  "private": true,
  "version": "0.1.0",
  "description": "Offline Electron GUI for GTFOBins, LOLBAS, WADComs and HijackLibs lookup.",
  "author": "fl4g-chzh <505647296@qq.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/fl4g-chzh/GTFOBLookup_GUI.git"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "sync": "tsx scripts/sync-all.ts",
    "build": "tsc -b && vite build",
    "pack:win": "electron-builder --win nsis --config.electronDist=node_modules/electron/dist",
    "dist:win": "npm run build && npm run pack:win",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "reinstall:electron": "cross-env ELECTRON_GET_USE_PROXY=true npm install electron@42.0.1 -D"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sql.js": "^1.14.1",
    "undici": "^8.2.0",
    "yaml": "^2.8.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.fl4gchzh.gtfoblookup",
    "productName": "GTFOBLookup",
    "directories": {
      "output": "release"
    },
    "files": [
      "app-dist/**/*",
      "dist-electron/**/*",
      "database/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
